# Example environment configuration
# Copy this file to .env and fill in your actual values

# AI Provider Configuration
# Choose which AI provider to use: 'gemini' or 'openai'
# If not specified, will use Gemini if available, otherwise OpenAI
AI_PROVIDER=gemini

# Google Gemini API Configuration (FREE - No credit card required!)
# Get your free API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Configuration (Requires paid account)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specify models
# GEMINI_MODEL=gemini-pro
# OPENAI_MODEL=gpt-4

# Optional: Output directories
# OUTPUT_DIR=./output
# TEMP_DIR=./temp
# CACHE_DIR=./cache
